# ============================================================
# ATB TAROT IA — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o .env.local no git
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# Obtenha em: https://app.supabase.com → Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço — SOMENTE no servidor, nunca no frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# ANTHROPIC (Claude API) — leituras de tarot via WhatsApp
# Obtenha em: https://console.anthropic.com → API Keys
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# ------------------------------------------------------------
# DEEPSEEK — produto de CHAT com a ATB
# Obtenha em: https://platform.deepseek.com
# ------------------------------------------------------------
DEEPSEEK_API_KEY=sk-...

# ------------------------------------------------------------
# OPENAI — geração da Limpeza Espiritual (modelo gpt-5)
# Obtenha em: https://platform.openai.com → API Keys
# ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5

# ------------------------------------------------------------
# RESEND — e-mails transacionais (acesso pós-compra + entrega da limpeza)
# Obtenha em: https://resend.com → API Keys
# RESEND_FROM_EMAIL deve ser de um domínio verificado no Resend
# ------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
# E-mail que recebe notificação de cada venda (opcional)
ADMIN_NOTIFY_EMAIL=

# ------------------------------------------------------------
# Z-API (WhatsApp)
# Obtenha em: https://app.z-api.io → Instâncias
# ------------------------------------------------------------
ZAPI_INSTANCE_ID=seu-instance-id
ZAPI_TOKEN=seu-token-zapi
ZAPI_SECURITY_TOKEN=seu-security-token-cliente

# ------------------------------------------------------------
# TRABALHOS ESPIRITUAIS (entrega híbrida com operador)
# Canal de comunicação: E-MAIL (Resend). Este produto NÃO usa WhatsApp.
# O cliente recebe um link único (/pedido/<token>) onde escreve o nome
# completo e a intenção e, depois, vê o registro do ritual.
# ------------------------------------------------------------
# Os avisos de novo pedido / dados recebidos / reembolso vão para o
# ADMIN_NOTIFY_EMAIL configurado na seção do Resend, acima.

# Allowlist do painel /admin/pedidos (e-mails separados por vírgula).
# Os e-mails precisam logar normalmente pelo /login (magic link).
# Sem a var, NINGUÉM acessa o painel (fail-closed).
ADMIN_EMAILS=

# ------------------------------------------------------------
# KIWIFY (checkout BRASIL)
# Webhook: Configurações → Webhooks → URL:
#   https://seu-dominio.vercel.app/api/webhooks/kiwify
# A Kiwify envia a assinatura como ?signature= (HMAC-SHA1 do corpo
# com o token abaixo).
# ------------------------------------------------------------
KIWIFY_WEBHOOK_TOKEN=seu-token-webhook-kiwify

# URLs de checkout dos produtos na Kiwify (branch Brasil do roteador
# /api/checkout/[plan]). Crie os produtos no painel da Kiwify e cole as URLs.
NEXT_PUBLIC_KIWIFY_BASIC_URL=
NEXT_PUBLIC_KIWIFY_PREMIUM_URL=
NEXT_PUBLIC_KIWIFY_PERGUNTA1_URL=
NEXT_PUBLIC_KIWIFY_PERGUNTA3_URL=
NEXT_PUBLIC_KIWIFY_PERGUNTA7_URL=
NEXT_PUBLIC_KIWIFY_LIMPEZA_URL=

# Mapeamento product_id → plano (recomendado; senão usa o valor em R$):
#   R$29 → basic | R$250 → premium | R$14,90 → pergunta1
#   R$19,90 → pergunta3 | R$39,90 → pergunta7 | R$100 → limpeza
KIWIFY_PRODUCT_BASIC=
KIWIFY_PRODUCT_PREMIUM=
KIWIFY_PRODUCT_PERGUNTA1=
KIWIFY_PRODUCT_PERGUNTA3=
KIWIFY_PRODUCT_PERGUNTA7=
KIWIFY_PRODUCT_LIMPEZA=

# ------------------------------------------------------------
# STRIPE (checkout INTERNACIONAL — todos os países exceto Brasil)
# O roteador /api/checkout/[plan] cria as sessões com price_data inline
# (não precisa cadastrar produtos no painel do Stripe).
# Webhook: Developers → Webhooks → URL:
#   https://seu-dominio.vercel.app/api/webhooks/stripe
# Eventos: checkout.session.completed,
#   checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed,
#   invoice.payment_succeeded, invoice.payment_failed,
#   customer.subscription.deleted, charge.refunded, charge.dispute.created
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Mapeamento price_id → plano (só necessário para Payment Links criados
# fora do roteador; sessões do roteador usam metadata.plan)
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PERGUNTA1=
STRIPE_PRICE_PERGUNTA3=
STRIPE_PRICE_PERGUNTA7=
STRIPE_PRICE_LIMPEZA=

# ------------------------------------------------------------
# LIMPEZA — token interno para reentrega manual
# (POST /api/limpeza/generate com header X-Internal-Token)
# ------------------------------------------------------------
INTERNAL_GEN_TOKEN=defina-um-token-aleatorio-longo

# ------------------------------------------------------------
# UPSTASH REDIS (Rate Limiting)
# Obtenha em: https://console.upstash.com → Redis → Connect
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxx

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://seu-dominio.vercel.app

# ------------------------------------------------------------
# GOOGLE ADS — conversion tracking (/obrigado) + landing /google-ads
# O ID de conversão NÃO é o número da conta (681-163-7911).
# Pegue em: Google Ads -> Objetivos -> Conversões -> [ação de conversão]
#   -> "Instalar a tag manualmente". O snippet mostra:
#        gtag('config', 'AW-XXXXXXXXXX')                <- ID
#        gtag('event','conversion',{send_to:'AW-XXXXXXXXXX/AbC-D_efGh12'})
#                                                        ^^^^^^^^^^^^ rótulo
# Sem estas duas vars nada é carregado e nenhum evento é disparado.
# ------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# ------------------------------------------------------------
# WHATSAPP público (botões da landing /google-ads)
# Formato internacional, só dígitos: 55 + DDD + numero
# Sem esta var os botões de WhatsApp não aparecem (nunca link morto em anúncio).
# ------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=
