# ============================================================
# ATB TAROT IA — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o .env.local no git
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# Obtenha em: https://app.supabase.com → Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço — SOMENTE no servidor, nunca no frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# ANTHROPIC (Claude API)
# Obtenha em: https://console.anthropic.com → API Keys
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# ------------------------------------------------------------
# Z-API (WhatsApp)
# Obtenha em: https://app.z-api.io → Instâncias
# ------------------------------------------------------------
ZAPI_INSTANCE_ID=seu-instance-id
ZAPI_TOKEN=seu-token-zapi
ZAPI_SECURITY_TOKEN=seu-security-token-cliente

# ------------------------------------------------------------
# KIWIFY WEBHOOK
# Na Kiwify: Configurações → Webhooks → adicionar URL:
#   https://seu-dominio.vercel.app/api/webhooks/kiwify
# O token é o valor que você define no campo "Token" da Kiwify.
# Ele será enviado no corpo do webhook (campo "token") e usado
# para validar a assinatura HMAC-SHA256 (campo "Signature").
# ------------------------------------------------------------
KIWIFY_WEBHOOK_TOKEN=seu-token-webhook-kiwify

# Mapeamento de produto → plano (OPCIONAL, mas recomendado).
# Cole aqui o product_id de cada produto na Kiwify. Quando preenchido, o
# webhook identifica o plano pelo product_id (mais confiável). Se não
# preenchido, o plano é inferido pelo valor pago:
#   R$29,00 → basic | R$291,65 → premium | R$19,90 → pergunta3 | R$100,00 → limpeza
KIWIFY_PRODUCT_BASIC=
KIWIFY_PRODUCT_PREMIUM=
KIWIFY_PRODUCT_PERGUNTA3=
KIWIFY_PRODUCT_LIMPEZA=

# ------------------------------------------------------------
# STRIPE
# Obtenha em: https://dashboard.stripe.com → Developers → API keys
# STRIPE_SECRET_KEY: chave secreta (sk_live_... ou sk_test_...).
#                    SOMENTE no servidor, nunca no frontend.
# STRIPE_WEBHOOK_SECRET: segredo de assinatura do endpoint de webhook.
#   No Stripe: Developers → Webhooks → adicionar endpoint:
#     https://seu-dominio.vercel.app/api/webhooks/stripe
#   Eventos a habilitar:
#     checkout.session.completed
#     invoice.payment_succeeded
#     invoice.payment_failed
#     customer.subscription.deleted
#   Após criar o endpoint, copie o "Signing secret" (whsec_...).
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Mapeamento de preço → plano (OPCIONAL, mas recomendado).
# Cole aqui o price id (price_...) de cada produto no Stripe. Quando
# preenchido, o webhook identifica o plano pelo price id. Se não preenchido,
# o plano é inferido pelo valor total pago (mesmos valores da Kiwify acima).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PERGUNTA3=
STRIPE_PRICE_LIMPEZA=

# ------------------------------------------------------------
# UPSTASH REDIS (Rate Limiting)
# Obtenha em: https://console.upstash.com → Redis → Connect
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxx

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://seu-dominio.vercel.app
